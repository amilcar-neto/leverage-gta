<div class="lv-item-body">
  <div class="lv-item-row">
    <div class="lv-item-field">
      <span class="lv-item-lbl">{{localize "LEVERAGE.ItemSheet.die"}}</span>
      <div class="lv-item-dice" role="group" aria-label="{{localize 'LEVERAGE.ItemSheet.dieHint'}}">
        {{#each dieChoices}}<span class="lv-item-die" data-die="{{faces}}">{{lvDie faces die=faces size=32 action="setDie" pressed=selected muted=muted label=label title=label}}</span>{{/each}}
      </div>
    </div>
    <div class="lv-item-field">
      <span class="lv-item-lbl">{{localize "LEVERAGE.ItemSheet.duration"}}</span>
      <div class="lv-item-seg" role="group" aria-label="{{localize 'LEVERAGE.ItemSheet.duration'}}">
        {{#each durations}}<button type="button" class="lv-item-seg-btn" data-action="setDuration" data-value="{{value}}" aria-pressed="{{#if pressed}}true{{else}}false{{/if}}" {{disabled @root.readonly}}>{{label}}</button>{{/each}}
      </div>
    </div>
  </div>
  <label class="lv-item-field">
    <span class="lv-item-lbl">{{localize "LEVERAGE.ItemSheet.note"}}</span>
    <input type="text" class="lv-item-input" name="system.note" value="{{system.note}}" title="{{system.note}}" {{disabled readonly}}>
  </label>
  <div class="lv-item-checks">
    <label class="lv-item-check" title="{{localize 'LEVERAGE.ItemSheet.weaponHint'}}"><input type="checkbox" name="system.weapon" {{checked system.weapon}} {{disabled readonly}}><span>{{localize "LEVERAGE.ItemSheet.weapon"}}</span></label>
    <label class="lv-item-check"><input type="checkbox" name="system.purchased" {{checked system.purchased}} {{disabled readonly}}><span>{{localize "LEVERAGE.ItemSheet.purchased"}}</span></label>
  </div>
</div>
