<div class="lv-item-body">
  <label class="lv-item-field">
    <span class="lv-item-lbl">{{localize "LEVERAGE.ItemSheet.role"}}</span>
    <span class="lv-item-select">
      <select name="system.role" {{disabled readonly}}>{{selectOptions roleChoices selected=system.role}}</select>
    </span>
  </label>
  <div class="lv-item-field lv-item-grow">
    <span class="lv-item-lbl">{{localize "LEVERAGE.ItemSheet.description"}}</span>
    {{#if canEdit}}<prose-mirror class="lv-item-rich" name="system.description" value="{{source.description}}" document-uuid="{{item.uuid}}" toggled="true">{{#if enriched.description}}{{{enriched.description}}}{{else}}<p class="lv-item-empty">{{localize "LEVERAGE.ItemSheet.descriptionPlaceholder"}}</p>{{/if}}</prose-mirror>
    {{else}}<div class="lv-item-rich lv-item-prose lv-scroll">{{#if enriched.description}}{{{enriched.description}}}{{else}}<p class="lv-item-empty">{{localize "LEVERAGE.ItemSheet.descriptionPlaceholder"}}</p>{{/if}}</div>{{/if}}
  </div>
</div>
