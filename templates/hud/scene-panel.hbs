{{#if show}}
<div class="lv-sp{{#if collapsed}} is-collapsed{{/if}}{{#if empty}} is-empty{{/if}}">
  <button type="button" class="lv-sp-toggle" data-action="toggleCollapsed" aria-expanded="{{#if collapsed}}false{{else}}true{{/if}}"
    aria-label="{{toggleLabel}}" data-tooltip="{{toggleLabel}}">
    <i class="fa-solid {{#if collapsed}}fa-chevron-right{{else}}fa-chevron-left{{/if}}" aria-hidden="true"></i>
    {{#if collapsed}}<span class="lv-sp-summary">{{summary}}</span>{{/if}}
  </button>

  {{#unless collapsed}}
  <div class="lv-sp-body">
    {{#if goal}}
    <span class="lv-sp-chip lv-sp-chip--goal" data-tooltip="{{goal}}"><i class="fa-solid fa-bullseye" aria-hidden="true"></i><span class="lv-sp-name">{{goal}}</span></span>
    {{/if}}

    {{#each sceneTraits}}
    <{{@root.chipTag}} class="lv-sp-chip lv-sp-chip--trait" {{#if @root.isGM}}type="button" data-action="openTracker" {{/if}}data-tooltip="{{name}}">{{{lvDie die die=die size=@root.dieSize}}}<span class="lv-sp-name">{{name}}</span></{{@root.chipTag}}>
    {{/each}}

    {{#each complications}}
    <{{@root.chipTag}} class="lv-sp-chip lv-sp-chip--complication" {{#if @root.isGM}}type="button" data-action="openTracker" {{/if}}data-tooltip="{{name}}">{{{lvDie die die=die size=@root.dieSize}}}<span class="lv-sp-name">{{name}}</span></{{@root.chipTag}}>
    {{/each}}

    {{#if isGM}}<button type="button" class="lv-sp-edit" data-action="openTracker" aria-label="{{localize "LEVERAGE.ScenePanel.edit"}}" data-tooltip="{{localize "LEVERAGE.ScenePanel.edit"}}"><i class="fa-solid fa-pen" aria-hidden="true"></i></button>{{/if}}
  </div>
  {{/unless}}
</div>
{{/if}}
