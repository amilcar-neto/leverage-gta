<div class="lv-hud-body{{#if minimized}} is-minimized{{/if}}">
  <button type="button" class="lv-hud-min" data-action="toggleMinimized" aria-pressed="{{minimized}}"
    aria-label="{{minimizeLabel}}" data-tooltip="{{minimizeLabel}}">
    <i class="fa-solid {{#if minimized}}fa-up-right-and-down-left-from-center{{else}}fa-down-left-and-up-right-to-center{{/if}}" aria-hidden="true"></i>
  </button>

  {{#if party.canToggle}}
  <button type="button" class="lv-hud-min lv-hud-party-btn" data-action="toggleParty" aria-pressed="{{party.enabled}}"
    aria-label="{{party.toggleLabel}}" data-tooltip="{{party.toggleLabel}}">
    <i class="fa-solid fa-users" aria-hidden="true"></i>
  </button>
  {{/if}}

  {{#if stars.show}}
  <div class="lv-hud-stars" role="group" aria-label="{{stars.label}}">
    {{#each stars.items as |s|}}
    <button type="button" class="lv-hud-star{{#if s.on}} is-on{{/if}}" data-action="setStars" data-level="{{s.n}}"
      data-tooltip="{{s.tip}}" aria-label="{{s.tip}}" {{#unless s.interactive}}disabled{{/unless}}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 1.8l3.1 6.4 7 .9-5.1 4.9 1.3 7L12 17.6 5.7 21l1.3-7L1.9 9.1l7-.9z"></path></svg>
      <span class="lv-hud-star-die">d{{s.die}}</span>
    </button>
    {{/each}}
  </div>
  {{/if}}

  {{#if money.show}}
  <button type="button" class="lv-hud-money{{#unless money.interactive}} is-locked{{/unless}}{{#unless money.hasActor}} is-dim{{/unless}}"
    data-action="payMoney" data-tooltip="{{money.tip}}" aria-label="{{money.tip}}" {{#unless money.interactive}}disabled{{/unless}}>
    <span class="lv-hud-label"><span class="lv-hud-text lv-hud-dollar" aria-hidden="true">$</span><span class="lv-hud-text lv-hud-cap">{{localize "LEVERAGE.HUD.moneyCap"}}</span></span>
    {{#if money.empty}}
      {{{lvDie 0 die=4 size=@root.dieSize money=true empty=true}}}
    {{else}}
      {{#each money.dice as |d|}}{{{lvDie d die=d size=@root.dieSize money=true}}}{{/each}}
    {{/if}}
  </button>
  {{/if}}

  {{#if party.show}}
  <section class="lv-hud-party{{#if party.collapsed}} is-collapsed{{/if}}" aria-label="{{party.title}}">
    <button type="button" class="lv-hud-party-head" data-action="collapseParty" aria-expanded="{{#if party.collapsed}}false{{else}}true{{/if}}"
      data-tooltip="{{party.collapseLabel}}">
      <span class="lv-hud-party-title">{{party.title}} · {{party.count}}</span>
      <i class="fa-solid {{#if party.collapsed}}fa-chevron-down{{else}}fa-chevron-up{{/if}}" aria-hidden="true"></i>
    </button>
    {{#unless party.collapsed}}
    <ul class="lv-hud-party-list">
      {{#each party.rows as |r|}}
      <li class="lv-hud-party-row" data-tooltip="{{r.name}} · {{r.steps}}">
        <span class="lv-hud-party-name">{{r.name}}</span>
        <span class="lv-hud-party-dice">
          {{#if r.empty}}{{{lvDie 0 die=4 size=party.dieSize money=true empty=true}}}
          {{else}}{{#each r.dice as |d|}}{{{lvDie d die=d size=party.dieSize money=true}}}{{/each}}{{/if}}
        </span>
      </li>
      {{else}}
      <li class="lv-hud-party-none">{{party.empty}}</li>
      {{/each}}
    </ul>
    {{/unless}}
  </section>
  {{/if}}

  {{#if plotPoints.show}}
  <div class="lv-hud-pp{{#unless plotPoints.hasActor}} is-dim{{/unless}}" data-tooltip="{{plotPoints.tip}}">
    <button type="button" class="lv-hud-round" data-action="spendPlotPoint" aria-label="{{plotPoints.spendLabel}}"
      data-tooltip="{{plotPoints.spendLabel}}" {{#unless plotPoints.canSpend}}disabled{{/unless}}>
      <span class="lv-hud-text lv-hud-round-text" aria-hidden="true">&minus;1</span>
    </button>
    {{#if plotPoints.canGain}}
    <button type="button" class="lv-hud-round" data-action="gainPlotPoint" aria-label="{{plotPoints.gainLabel}}"
      data-tooltip="{{plotPoints.gainLabel}}">
      <span class="lv-hud-text lv-hud-round-text" aria-hidden="true">+1</span>
    </button>
    {{/if}}
    <svg class="lv-hud-chip" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><text x="12" y="15.4" text-anchor="middle" class="lv-hud-chip-text">{{localize "LEVERAGE.HUD.ppCap"}}</text></svg>
    <span class="lv-hud-text lv-hud-pp-value{{#if plotPoints.pulse}} is-pulse{{/if}}"{{#if plotPoints.canGain}} data-action="gainPlotPoint" role="button" tabindex="0" aria-label="{{plotPoints.gainLabel}}"{{/if}}>{{plotPoints.value}}</span>
  </div>
  {{/if}}
</div>
