<div class="leverage-gta lv-stars-line lv-stars-line--{{direction}}">
  <div class="lv-stars-head">
    <span class="lv-stars-label hud">{{label}}</span>
    <span class="lv-stars-icons" aria-hidden="true">{{#each stars}}<i class="lv-stars-star{{#if on}} is-on{{/if}}">&#9733;</i>{{/each}}</span>
    <span class="lv-stars-change">{{change}}</span>
  </div>
  <p class="lv-stars-reason" title="{{reason}}">{{reason}}</p>
</div>
