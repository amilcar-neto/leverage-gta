<section class="lv-panel lv-assets">
  <h2 class="lv-panel-head">
    <span>{{localize "LEVERAGE.Sheet.Panel.assets"}}</span>
    <span class="lv-head-tools">
      <span class="lv-panel-hint">{{assetRows.length}}</span>
      {{#if canEdit}}<button type="button" class="lv-add-btn" data-action="addAsset">{{localize "LEVERAGE.Sheet.Add"}}</button>{{/if}}
    </span>
  </h2>
  <div class="lv-panel-body lv-list lv-scroll">
    {{#each assetRows}}
    <div class="lv-row lv-asset draggable" data-item-id="{{id}}">
      <span class="lv-row-main" data-action="togglePool" data-pool-ref="item:{{id}}">
        <span class="lv-row-name lv-ellipsis" role="button" tabindex="0" data-action="togglePool" data-pool-ref="item:{{id}}" aria-pressed="false" title="{{name}}">{{name}}</span>
        <span class="lv-asset-meta">
          <span class="lv-tag lv-tag--{{duration}}">{{durationLabel}}</span>
          {{#if note}}<span class="lv-row-note lv-ellipsis" title="{{note}}">{{note}}</span>{{/if}}
        </span>
      </span>
      <button type="button" class="lv-die-btn{{#if boosted}} is-boosted{{/if}}" data-action="togglePool" data-pool-ref="item:{{id}}" aria-pressed="false" aria-label="{{localize 'LEVERAGE.Sheet.addToPool'}}" title="{{#if boosted}}{{boostTip}}{{else}}{{localize 'LEVERAGE.Sheet.addToPool'}}{{/if}}">{{lvDie die die=die size=32}}</button>
      <button type="button" class="lv-xbtn lv-xbtn--open" data-action="openAsset" aria-label="{{localize 'LEVERAGE.Sheet.Assets.open'}}" title="{{localize 'LEVERAGE.Sheet.Assets.open'}}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg></button>
      {{#if @root.canEdit}}{{> "systems/leverage-gta/templates/actor/crew/partials/x-button.hbs" action="deleteAsset" label=(localize "LEVERAGE.Sheet.Assets.delete")}}{{/if}}
    </div>
    {{else}}
    <p class="lv-empty">{{localize "LEVERAGE.Sheet.Empty.assets"}}</p>
    {{/each}}
  </div>
</section>
