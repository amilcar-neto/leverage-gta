<section class="lv-panel lv-assets">
  <h2 class="lv-panel-head">
    <span>{{localize "LEVERAGE.Sheet.Panel.assets"}}</span>
    <span class="lv-head-tools">
      <span class="lv-panel-hint">{{assetRows.length}}</span>
      {{#if assetsEditable}}<button type="button" class="lv-add-btn" data-action="addAsset" title="{{localize 'LEVERAGE.Sheet.Assets.addHint'}}">{{localize "LEVERAGE.Sheet.Add"}}</button>{{/if}}
    </span>
  </h2>
  <div class="lv-panel-body lv-list lv-scroll">
    {{#each assetRows}}
    <div class="lv-row lv-asset" data-item-id="{{id}}" title="{{localize 'LEVERAGE.Sheet.Assets.dblclick'}}">
      <span class="lv-row-main" data-action="togglePool" data-pool-ref="item:{{id}}">
        <span class="lv-row-name lv-ellipsis" title="{{name}}">{{name}}</span>
        <span class="lv-asset-meta">
          <span class="lv-tag lv-tag--{{duration}}" title="{{durationTip}}">{{durationLabel}}</span>
          {{#if note}}<span class="lv-row-note lv-ellipsis" title="{{note}}">{{note}}</span>{{/if}}
        </span>
      </span>
      <button type="button" class="lv-die-btn" data-action="togglePool" data-pool-ref="item:{{id}}" aria-label="{{localize 'LEVERAGE.Sheet.addToPool'}}" title="{{localize 'LEVERAGE.Sheet.addToPool'}}">{{lvDie die die=die size=32}}</button>
      {{#if ../assetsEditable}}<button type="button" class="lv-xbtn" data-action="deleteAsset" aria-label="{{localize 'LEVERAGE.Sheet.Assets.delete'}}" title="{{localize 'LEVERAGE.Sheet.Assets.delete'}}"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>{{/if}}
    </div>
    {{else}}
    <p class="lv-empty">{{localize "LEVERAGE.Sheet.Empty.assets"}}</p>
    {{/each}}
  </div>
</section>
