{{#*inline "chip"}}<button type="button" class="lv-chip{{#if optional}} is-optional{{/if}}{{#if problem}} is-problem{{/if}}{{#if warn}} has-warning{{/if}}" data-action="removeFromPool" data-pool-ref="{{ref}}" data-kind="{{kind}}" title="{{title}}"><span class="lv-chip-text"><span class="lv-chip-kind">{{kindLabel}}</span><span class="lv-chip-name">{{name}}</span></span>{{#if die}}{{lvDie die die=die size=36 money=money}}{{/if}}</button>{{/inline}}
{{#*inline "ghost"}}<span class="lv-chip is-ghost"><span class="lv-chip-text"><span class="lv-chip-kind">{{kindLabel}}</span><span class="lv-chip-name">&mdash;</span></span></span>{{/inline}}
<footer class="lv-tray"{{#unless isOwner}} hidden{{/unless}}>
  <div class="lv-tray-title">
    <span class="lv-tray-label">{{localize "LEVERAGE.Sheet.Tray.pool"}}</span>
    <span class="lv-tray-count">{{localize "LEVERAGE.Sheet.Tray.count" count=pool.count keep=pool.keep}}</span>
  </div>
  <div class="lv-tray-chips">
    {{#if pool.attribute}}{{> chip pool.attribute}}{{else}}{{> ghost pool.required.attribute}}{{/if}}
    <span class="lv-tray-plus" aria-hidden="true">+</span>
    {{#if pool.role}}{{> chip pool.role}}{{else}}{{> ghost pool.required.role}}{{/if}}
    {{#if pool.optional.length}}<span class="lv-tray-sep" aria-hidden="true"></span>{{/if}}
    {{#each pool.optional as |chip|}}{{> chip chip}}{{/each}}
    <button type="button" class="lv-chip lv-chip--add is-optional" data-action="addDie" aria-haspopup="dialog">{{localize "LEVERAGE.Sheet.Tray.addDie"}}</button>
    {{#unless pool.empty}}<button type="button" class="lv-tray-clear" data-action="clearPool">{{localize "LEVERAGE.Sheet.Tray.clear"}}</button>{{/unless}}
  </div>
  <button type="button" class="lv-roll-btn" data-action="roll"{{#unless pool.canRoll}} disabled title="{{pool.rollTitle}}"{{/unless}}>{{localize "LEVERAGE.Sheet.Tray.roll"}}</button>
</footer>
