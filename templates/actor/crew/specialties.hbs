<section class="lv-panel lv-specialties">
  <h2 class="lv-panel-head"><span>{{localize "LEVERAGE.Sheet.Panel.specialties"}}</span><span class="lv-panel-hint">{{localize "LEVERAGE.Sheet.Hint.specialtyDie"}}</span></h2>
  <div class="lv-panel-body lv-grid-2 lv-scroll">
    {{#each specialties}}
    <div class="lv-row" data-item-id="{{id}}"><span class="lv-row-name lv-ellipsis" title="{{name}}">{{name}}</span></div>
    {{else}}
    <p class="lv-empty">{{localize "LEVERAGE.Sheet.Empty.specialties"}}</p>
    {{/each}}
  </div>
</section>
