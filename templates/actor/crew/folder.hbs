<section class="lv-folder">
  <div class="lv-folder-tabs" role="tablist">
    <button type="button" class="lv-folder-tab{{#if tabBackground}} is-active{{/if}}" role="tab" aria-selected="{{#if tabBackground}}true{{else}}false{{/if}}" data-action="folderTab" data-tab="background">{{localize "LEVERAGE.Sheet.Folder.background"}}</button>
    <button type="button" class="lv-folder-tab{{#if tabJobs}} is-active{{/if}}" role="tab" aria-selected="{{#if tabJobs}}true{{else}}false{{/if}}" data-action="folderTab" data-tab="jobs">{{localize "LEVERAGE.Sheet.Folder.jobs"}}</button>
    {{#if tabBackground}}{{#if canEdit}}
    <span class="lv-folder-tools">
      {{#if bgEditing}}
      <button type="button" class="lv-icon-btn lv-icon-btn--ok" data-action="saveBackground" aria-label="{{localize 'LEVERAGE.Sheet.Folder.save'}}" title="{{localize 'LEVERAGE.Sheet.Folder.save'}}"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg></button>
      <button type="button" class="lv-icon-btn" data-action="cancelBackground" aria-label="{{localize 'LEVERAGE.Sheet.Folder.cancel'}}" title="{{localize 'LEVERAGE.Sheet.Folder.cancel'}}"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
      {{else}}
      <button type="button" class="lv-icon-btn" data-action="editBackground" aria-label="{{localize 'LEVERAGE.Sheet.Folder.edit'}}" title="{{localize 'LEVERAGE.Sheet.Folder.edit'}}"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20l1-5L16 4l4 4L9 19zM14 6l4 4"/></svg></button>
      {{/if}}
    </span>
    {{/if}}{{/if}}
  </div>
  <div class="lv-folder-page lv-paper">
    {{#if tabJobs}}
    <div class="lv-jobs-bar">
      <span class="lv-jobs-summary lv-ellipsis" title="{{jobsSummary}}">{{jobsSummary}}</span>
      {{#if canEdit}}
      <span class="lv-jobs-actions">
      <button type="button" class="lv-paper-btn lv-paper-btn--solid" data-action="trainUp" title="{{localize 'LEVERAGE.Sheet.Jobs.trainUpHint'}}">{{localize "LEVERAGE.Sheet.Jobs.trainUp"}}</button>
      <button type="button" class="lv-paper-btn" data-action="logJob" title="{{localize 'LEVERAGE.Sheet.Jobs.logHint'}}">{{localize "LEVERAGE.Sheet.Jobs.log"}}</button>
      </span>
      {{/if}}
    </div>
    <div class="lv-jobs-cols" aria-hidden="true">
      <span class="lv-jobs-col-name">{{localize "LEVERAGE.Sheet.Jobs.colJob"}}</span>
      <span class="lv-jobs-col-share" title="{{localize 'LEVERAGE.Sheet.Jobs.colShareHint'}}">$</span>
      <span class="lv-jobs-col-callback" title="{{localize 'LEVERAGE.Sheet.Jobs.colCallbackHint'}}">{{localize "LEVERAGE.Sheet.Jobs.colCallback"}}</span>
      <span class="lv-jobs-col-x"></span>
    </div>
    <div class="lv-folder-text lv-scroll lv-jobs-list">
      {{#each jobRows}}
      <div class="draggable lv-job{{#if spent}} is-spent{{/if}}" data-item-id="{{id}}">
        <button type="button" class="lv-job-name lv-ellipsis" data-action="openJob" title="{{name}} - {{localize 'LEVERAGE.Sheet.Jobs.openHint'}}">{{name}}</button>
        {{#if spent}}<span class="lv-stamp-spent">{{localize "LEVERAGE.Sheet.Jobs.spent"}}</span>{{/if}}
        <span class="lv-job-share">{{#if share}}+{{share}}{{/if}}</span>
        <span class="lv-job-callback">{{#unless spent}}<button type="button" class="lv-check{{#if callbackUsed}} is-on{{/if}}" data-action="toggleCallback" aria-pressed="{{#if callbackUsed}}true{{else}}false{{/if}}" aria-label="{{localize 'LEVERAGE.Sheet.Jobs.callbackLabel'}}" title="{{localize 'LEVERAGE.Sheet.Jobs.callbackLabel'}}"{{#unless @root.canEdit}} disabled{{/unless}}><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg></button>{{/unless}}</span>
        <span class="lv-job-x">{{#if @root.canEdit}}{{> "systems/leverage-gta/templates/actor/crew/partials/x-button.hbs" action="deleteJob" label=(localize "LEVERAGE.Sheet.Jobs.delete") small=true}}{{/if}}</span>
      </div>
      {{else}}
      <p class="lv-empty">{{localize "LEVERAGE.Sheet.Empty.jobs"}}</p>
      {{/each}}
    </div>
    {{else}}
    {{#if bgEditing}}
    <prose-mirror class="lv-bg-editor" name="background" value="{{bgRaw}}"></prose-mirror>
    {{else}}
    <div class="lv-folder-text lv-scroll lv-bg-text{{#if canEdit}} is-editable{{/if}}">
      {{#if background}}{{{background}}}{{else}}<p class="lv-empty">{{localize "LEVERAGE.Sheet.Empty.background"}}</p>{{/if}}
    </div>
    {{/if}}
    {{/if}}
  </div>
</section>
