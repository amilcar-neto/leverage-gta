<section class="lv-panel lv-attributes">
  <h2 class="lv-panel-head"><span>{{localize "LEVERAGE.Sheet.Panel.attributes"}}</span></h2>
  <div class="lv-panel-body lv-list">
    {{#each attributes}}
    <div class="lv-row lv-ladder-row{{#if blank}} is-blank{{else}} draggable{{/if}}" data-key="{{key}}" data-group="{{group}}"{{#unless blank}} data-trait-ref="{{poolRef}}"{{/unless}}>
      {{#if blank}}
      <span class="lv-row-name lv-ellipsis" title="{{nameTitle}}">{{label}}</span>
      {{else}}
      <button type="button" class="lv-row-name lv-ellipsis lv-name-btn" data-action="togglePool" data-pool-ref="{{poolRef}}" aria-pressed="false" title="{{nameTitle}}">{{label}}</button>
      {{/if}}
      <span class="lv-ladder">{{#each ladder}}{{lvDie die die=die size=32 muted=muted action=action pressed=pressed label=label title=title}}{{/each}}</span>
    </div>
    {{/each}}
  </div>
</section>
