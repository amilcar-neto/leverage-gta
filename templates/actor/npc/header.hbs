{{#*inline "badgeFace"}}
  <span class="lv-badge-slot" aria-hidden="true"></span>
  <span class="lv-badge-photo">
    {{#if hasPhoto}}<img class="lv-badge-img" src="{{actor.img}}" alt="{{actor.name}}">{{else}}<i class="fa-solid {{tierIcon}} lv-badge-silhouette" aria-hidden="true"></i>{{/if}}
  </span>
  <span class="lv-badge-band">{{#if system.police}}<i class="fa-solid fa-shield-halved" aria-hidden="true"></i> {{localize "LEVERAGE.NpcSheet.police"}}{{else}}{{localize tierLabel}}{{/if}}</span>
{{/inline}}
<header class="lv-npc-head">
  {{#if canEdit}}
  <button type="button" class="lv-badge lv-badge--edit" data-action="pickPhoto" data-tooltip="LEVERAGE.Sheet.Header.pickPhoto" aria-label="{{localize 'LEVERAGE.Sheet.Header.pickPhoto'}}">{{> badgeFace}}</button>
  {{else}}
  <div class="lv-badge">{{> badgeFace}}</div>
  {{/if}}
  <div class="lv-npc-identity">
    {{#if canEdit}}
    <input type="text" class="lv-name lv-hud lv-ellipsis lv-inline" name="name" value="{{actor.name}}" title="{{actor.name}}" placeholder="{{localize 'LEVERAGE.Sheet.Header.namePlaceholder'}}" aria-label="{{localize 'LEVERAGE.Sheet.Header.name'}}">
    {{else}}
    <div class="lv-name lv-hud lv-ellipsis" title="{{actor.name}}">{{actor.name}}</div>
    {{/if}}
    <div class="lv-npc-tags">
      {{#if canEdit}}
      <select class="lv-tag lv-tag-select" name="system.tier" aria-label="{{localize 'LEVERAGE.NpcSheet.tier'}}">
        {{selectOptions tiers selected=system.tier localize=true}}
      </select>
      <button type="button" class="lv-tag lv-tag-toggle{{#if system.police}} is-on{{/if}}" data-action="togglePolice" aria-pressed="{{#if system.police}}true{{else}}false{{/if}}"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> {{localize "LEVERAGE.NpcSheet.police"}}</button>
      {{else}}
      <span class="lv-tag lv-tag--role">{{localize tierLabel}}</span>
      {{#if system.police}}<span class="lv-tag lv-tag--police"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> {{localize "LEVERAGE.NpcSheet.police"}}</span>{{/if}}
      {{/if}}
    </div>
    {{#if showVitals}}
    <div class="lv-npc-vitals">
      <div class="lv-npc-vital lv-npc-vital--life">
        <svg class="lv-npc-vital-icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M12 21s-7.5-4.6-9.4-9.3C1.2 8.2 3.4 4.5 7 4.5c2 0 3.5 1.1 5 3 1.5-1.9 3-3 5-3 3.6 0 5.8 3.7 4.4 7.2C19.5 16.4 12 21 12 21z"/></svg>
        <span class="lv-npc-cap">{{localize "LEVERAGE.Sheet.Header.life"}}</span>
        {{#if canEdit}}<input type="number" class="lv-npc-num lv-hud" name="system.life.value" value="{{system.life.value}}" min="0" max="{{system.life.max}}" step="1" aria-label="{{localize 'LEVERAGE.Sheet.Header.life'}}">
        {{else}}<span class="lv-npc-num lv-hud">{{system.life.value}}</span>{{/if}}
        <span class="lv-npc-max">/{{#if lifeMaxEditable}}<input type="number" class="lv-npc-num lv-npc-num--max" name="system.life.max" value="{{system.life.max}}" min="0" step="1" aria-label="{{localize 'LEVERAGE.NpcSheet.lifeMax'}}">{{else}}{{system.life.max}}{{/if}}</span>
      </div>
      <div class="lv-npc-vital lv-npc-vital--vest">
        <svg class="lv-npc-vital-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 2.5l8 3v6c0 5-3.4 8.6-8 10-4.6-1.4-8-5-8-10v-6z"/></svg>
        <span class="lv-npc-cap">{{localize "LEVERAGE.Sheet.Header.vest"}}</span>
        {{#if canEdit}}<input type="number" class="lv-npc-num lv-hud" name="system.vest.value" value="{{system.vest.value}}" min="0" max="{{system.vest.max}}" step="1" aria-label="{{localize 'LEVERAGE.Sheet.Header.vest'}}">
        {{else}}<span class="lv-npc-num lv-hud">{{system.vest.value}}</span>{{/if}}
        <span class="lv-npc-max">/{{system.vest.max}}</span>
        {{#if canEdit}}
        <select class="lv-npc-kind" data-vest-kind aria-label="{{localize 'LEVERAGE.NpcSheet.vestKind'}}">
          {{selectOptions vestKinds selected=system.vest.kind localize=true}}
        </select>
        {{else}}<span class="lv-npc-kind-text">{{localize vestLabel}}</span>{{/if}}
      </div>
    </div>
    {{/if}}
  </div>
</header>
