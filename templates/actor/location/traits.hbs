<section class="lv-panel lv-loc-traits">
  <h2 class="lv-panel-head"><span>{{localize "LEVERAGE.LocationSheet.traits"}}</span><span class="lv-head-tools">{{#if canManage}}<span class="lv-panel-hint">{{localize "LEVERAGE.LocationSheet.traitsHint"}}</span><button type="button" class="lv-add-btn" data-action="addTrait" title="{{localize 'LEVERAGE.LocationSheet.addTrait'}}">{{localize "LEVERAGE.Sheet.Add"}}</button>{{/if}}</span></h2>
  <div class="lv-panel-body lv-scroll lv-loc-list">
    {{#each traits}}
    <div class="lv-row lv-loc-trait" data-index="{{index}}"{{#if @root.canManage}} draggable="true"{{/if}}>
      {{#if @root.canManage}}
      <input type="text" class="lv-loc-trait-name lv-ellipsis" data-trait-name data-index="{{index}}" value="{{name}}" title="{{name}}" placeholder="{{localize 'LEVERAGE.LocationSheet.traitPlaceholder'}}" aria-label="{{localize 'LEVERAGE.LocationSheet.traitName'}}">
      <div class="lv-loc-ladder">
        {{#each ladder}}{{lvDie die die=die size=28 muted=muted action="setTraitDie" pressed=selected label=label}}{{/each}}
      </div>
      {{> "systems/leverage-gta/templates/actor/crew/partials/x-button.hbs" action="deleteTrait" label=(localize "LEVERAGE.Sheet.delete") small=true}}
      {{else}}
      <span class="lv-loc-trait-name lv-ellipsis" title="{{name}}">{{#if name}}{{name}}{{else}}{{localize "LEVERAGE.LocationSheet.traitPlaceholder"}}{{/if}}</span>
      {{lvDie die die=die size=28}}
      {{/if}}
    </div>
    {{else}}
    <p class="lv-loc-empty">{{localize "LEVERAGE.LocationSheet.emptyTraits"}}</p>
    {{/each}}
  </div>
</section>
