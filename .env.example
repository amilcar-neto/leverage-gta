# Copy to .env and fill in. .env never goes to git and never leaves this PC.
FOUNDRY_URL=https://foundry.example.com
FOUNDRY_WORLD=leverage-dev
FOUNDRY_USER=Claude
FOUNDRY_PASSWORD=
# Optional: a Player user to test permissions
FOUNDRY_PLAYER_USER=
FOUNDRY_PLAYER_PASSWORD=
# Optional: lets the agent relaunch the world after system.json changes
FOUNDRY_ADMIN_PASSWORD=

# Deploy over SSH (the key's passphrase stays in ssh-agent, not here)
VPS_SSH=user@1.2.3.4
VPS_SSH_PORT=22
VPS_SSH_KEY=C:\Users\you\.ssh\vps.key
# Must end with /systems/leverage-gta
VPS_SYSTEM_DIR=/home/foundry/foundrydata/Data/systems/leverage-gta
